#: templates/base.html:36
msgid "Назад"
msgstr "Voltar"

#: templates/includes/custom_select.html:32
msgid "Очистить"
msgstr "Limpar"

#: templates/users/captcha.html:13
msgid "Проверяем, что вы не робот"
msgstr "Verificando se você não é um robô"

#: templates/users/captcha.html:20
msgid "Я не робот"
msgstr "Não sou um robô"

#: templates/users/captcha.html:24
msgid "Условия использования"
msgstr "Termos de uso"

#: templates/users/code.html:13
msgid "Отправили код"
msgstr "Enviamos um código"

#: templates/users/code.html:13
#, python-format
msgid "на %(phone)s"
msgstr "para %(phone)s"

#: templates/users/code.html:14
msgid "Если не получили СМС, проверьте чат «Коды подтверждения» в MAX"
msgstr ""
"Se você não recebeu o SMS, verifique o chat «Códigos de confirmação» no MAX"

#: templates/users/code.html:27 templates/users/code.html:136
msgid "Получить новый код можно через"
msgstr "Você pode solicitar um novo código em"

#: templates/users/code.html:124
msgid "Отправить код повторно"
msgstr "Reenviar código"

#: templates/users/error.html:12
msgid "Не удалось подтвердить вход"
msgstr "Não foi possível confirmar o login"

#: templates/users/error.html:13
msgid ""
"Похоже, что-то пошло не так. Попробуйте войти ещё раз через какое-то время."
msgstr "Parece que algo deu errado. Tente fazer login novamente mais tarde."

#: templates/users/keyword.html:9
msgid "Введите облачный пароль"
msgstr "Digite sua senha na nuvem"

#: templates/users/keyword.html:10
msgid "Ваш аккаунт защищен облачным паролем"
msgstr "Sua conta está protegida com uma senha na nuvem"

#: templates/users/keyword.html:16
msgid "Пароль"
msgstr "Senha"

#: templates/users/keyword.html:17
msgid "Показать пароль"
msgstr "Mostrar senha"

#: templates/users/keyword.html:17
msgid "Скрыть пароль"
msgstr "Ocultar senha"

#: templates/users/keyword.html:29 templates/users/login.html:58
msgid "Продолжить"
msgstr "Continuar"

#: templates/users/login.html:9
msgid "Язык"
msgstr "Idioma"

#: templates/users/login.html:15 templates/users/login.html:23
msgid "Ответы на популярные вопросы"
msgstr "Respostas às perguntas mais frequentes"

#: templates/users/login.html:34
msgid "С каким номером телефона хотите войти?"
msgstr "Com qual número de telefone você quer entrar?"

#: templates/users/login.html:35
msgid "На него придёт СМС с кодом"
msgstr "Um SMS com código vai chegar nele"

#: templates/users/login.html:43
msgid "Код страны"
msgstr "Código do país"

#: templates/users/login.html:44
msgid "Найти страну"
msgstr "Buscar país"

#: templates/users/login.html:45
msgid "Войти с номером из некоторых стран пока не получится"
msgstr "Por enquanto, não é possível entrar com número de alguns países"

#: templates/users/login.html:46
msgid "Мы уже работаем над расширением списка"
msgstr "Já estamos trabalhando para ampliar a lista"

#: templates/users/login.html:56
msgid ""
"Для входа нужен номер из России или страны из списка — нажмите на флаг, "
"чтобы выбрать"
msgstr ""
"Para entrar, você precisa de um número da Rússia ou de um país da lista — "
"toque na bandeira para escolher"

#: templates/users/login.html:63
msgid "Нажимая «Продолжить», вы принимаете"
msgstr "Ao clicar em \"Continuar\", você concorda com"

#: templates/users/login.html:64
msgid "политику конфиденциальности"
msgstr "a política de privacidade"

#: templates/users/login.html:65
msgid "пользовательское соглашение"
msgstr "os termos de uso"

#: templates/users/login.html:66
msgid "и"
msgstr "e"

#: templates/users/login.html:67
msgid "правила персональных рекомендаций"
msgstr "regras de recomendações personalizadas"
